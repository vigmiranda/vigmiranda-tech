---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  site,
  projects,
  experiences,
  education,
} from '../data/site';
---

<BaseLayout>
  <header class="top">
    <div class="wrap top-inner">
      <a class="top-brand" href="#topo"
        ><span class="brand-name">Vigmiranda</span><span class="brand-tld">.Tech</span></a
      >
      <nav class="top-nav" aria-label="Principal">
        <a href="#projetos">Projetos</a>
        <a href="#experiencia">Experiência</a>
        <a href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <main id="topo">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="hero-brand">
            <span class="brand-name">Vigmiranda</span><span class="brand-tld">.Tech</span>
          </p>
          <h1 class="hero-headline">{site.headline}</h1>
          <p class="hero-support">
            {site.name} · {site.tagline} · {site.location}
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#projetos">Ver projetos</a>
            <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener noreferrer"
              >LinkedIn</a
            >
          </div>
        </div>
        <figure class="hero-media">
          <img
            src="/vitor.jpg"
            alt={`${site.name} — engenharia e produtos`}
            width="1024"
            height="1024"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <section class="section about" id="sobre" aria-labelledby="sobre-title">
      <div class="wrap reveal">
        <span class="section-label">Sobre</span>
        <h2 class="section-title" id="sobre-title">Engenharia com ownership</h2>
        <p class="section-lead about-copy">{site.summary}</p>
        <ul class="stack-list" aria-label="Stack principal">
          {site.stack.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section projects" id="projetos" aria-labelledby="projetos-title">
      <div class="wrap">
        <div class="reveal">
          <span class="section-label">Projetos</span>
          <h2 class="section-title" id="projetos-title">O que estou tocando</h2>
          <p class="section-lead">
            Produtos e infra que construo ou lidero — do SaaS de conteúdo ao gateway de IA.
          </p>
        </div>
        <ul class="project-grid">
          {
            projects.map((project, i) => (
              <li
                class="project reveal"
                style={`transition-delay: ${Math.min(i, 4) * 60}ms`}
              >
                <div class="project-meta">
                  <h3 class="project-name">{project.name}</h3>
                  <span class="project-role">{project.role}</span>
                </div>
                <p class="project-blurb">{project.blurb}</p>
                <ul class="project-tags">
                  {project.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section experience" id="experiencia" aria-labelledby="exp-title">
      <div class="wrap">
        <div class="reveal">
          <span class="section-label">Experiência</span>
          <h2 class="section-title" id="exp-title">Trajetória</h2>
          <p class="section-lead">
            Destaques recentes — bancos, fintech e liderança técnica hands-on.
          </p>
        </div>
        <ol class="timeline">
          {
            experiences.map((item, i) => (
              <li
                class="timeline-item reveal"
                style={`transition-delay: ${Math.min(i, 5) * 40}ms`}
              >
                <div class="timeline-head">
                  <h3 class="timeline-role">{item.role}</h3>
                  <time class="timeline-period">{item.period}</time>
                </div>
                <p class="timeline-company">{item.company}</p>
                <p class="timeline-highlight">{item.highlight}</p>
              </li>
            ))
          }
        </ol>
        <div class="edu reveal">
          <h3 class="edu-title">Formação</h3>
          <ul class="edu-list">
            {
              education.map((item) => (
                <li>
                  <strong>{item.place}</strong>
                  <span>{item.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section contact" id="contato" aria-labelledby="contato-title">
      <div class="wrap contact-inner reveal">
        <span class="section-label">Contato</span>
        <h2 class="section-title" id="contato-title">Vamos conversar</h2>
        <p class="section-lead">
          Aberto a oportunidades remote-first e parcerias em produtos de engenharia.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener noreferrer"
            >LinkedIn</a
          >
          <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <p>
        <strong>{site.brand}</strong>
        <span aria-hidden="true"> · </span>
        {site.name}
      </p>
      <p class="footer-note">© {new Date().getFullYear()} · {site.domain.replace('https://', '')}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
    background: rgba(11, 16, 23, 0.72);
    border-bottom: 1px solid var(--line);
  }

  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3.5rem;
    min-width: 0;
  }

  .top-brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: var(--paper);
    text-decoration: none;
    min-width: 0;
    flex-shrink: 1;
  }

  .top-brand .brand-name,
  .top-brand .brand-tld {
    white-space: nowrap;
  }

  .top-brand:hover {
    color: var(--copper-bright);
  }

  .top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .top-nav a {
    color: var(--mist);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .top-nav a:hover {
    color: var(--paper);
  }

  .hero {
    min-height: min(88svh, 48rem);
    display: grid;
    align-items: center;
    padding-block: clamp(2.5rem, 8vw, 5.5rem) clamp(2.25rem, 6vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.75rem);
    align-items: center;
    min-width: 0;
    width: 100%;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
    container-type: inline-size;
    container-name: hero;
  }

  /* Uma linha só, escala pela largura útil — Syne é bem larga */
  .hero-brand {
    font-family: var(--font-display);
    font-size: min(4.75rem, calc(100cqi / 12.5));
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--paper);
    margin: 0 0 1.15rem;
    max-width: 100%;
    white-space: nowrap;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-brand .brand-name,
  .hero-brand .brand-tld {
    white-space: nowrap;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 3.8cqi + 0.75rem, 1.55rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--fog);
    margin: 0 0 1rem;
    max-width: 28rem;
    overflow-wrap: break-word;
    hyphens: manual;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
  }

  .hero-support {
    margin: 0 0 1.75rem;
    color: var(--mist);
    font-size: 0.92rem;
    line-height: 1.5;
    overflow-wrap: break-word;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.32s both;
  }

  .hero-media {
    margin: 0;
    min-width: 0;
    width: min(100%, 22rem);
    justify-self: center;
    animation: rise 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
  }

  .hero-media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }

  @media (min-width: 860px) {
    .hero {
      padding-inline: 0;
    }

    .hero-grid {
      width: min(100% - 2 * var(--space), var(--max));
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
      min-height: min(78svh, 40rem);
    }

    .hero-copy {
      padding-right: clamp(1.5rem, 3vw, 2.5rem);
      align-self: center;
    }

    .hero-media {
      width: auto;
      max-width: none;
      justify-self: stretch;
      align-self: stretch;
      /* sangra até a borda direita da viewport */
      margin-right: calc(-1 * max(0px, (100vw - min(100vw, var(--max))) / 2 + var(--space)));
      width: calc(100% + max(0px, (100vw - min(100vw, var(--max))) / 2 + var(--space)));
      min-height: min(78svh, 40rem);
    }

    .hero-media img {
      width: 100%;
      height: 100%;
      max-height: none;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: center 20%;
      mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    max-width: 100%;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    overflow-wrap: anywhere;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--copper);
    color: var(--ink);
  }

  .btn-primary:hover {
    background: var(--copper-bright);
    color: var(--ink);
  }

  .btn-ghost {
    background: transparent;
    color: var(--paper);
    border-color: var(--line);
  }

  .btn-ghost:hover {
    border-color: var(--copper);
    color: var(--copper-bright);
  }

  .about-copy {
    font-size: 1.08rem;
  }

  .stack-list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-list li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--fog);
    letter-spacing: 0.02em;
  }

  .project-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project {
    min-width: 0;
    padding: 1.35rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(18, 26, 36, 0.55);
    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .project:hover {
    border-color: rgba(212, 160, 106, 0.35);
    background: rgba(18, 26, 36, 0.85);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-bottom: 0.65rem;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--paper);
    margin: 0;
  }

  .project-role {
    font-size: 0.8rem;
    color: var(--steel);
  }

  .project-blurb {
    margin: 0 0 1rem;
    color: var(--mist);
    font-size: 0.98rem;
  }

  .project-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tags li {
    font-size: 0.75rem;
    color: var(--fog);
    opacity: 0.85;
  }

  .project-tags li:not(:last-child)::after {
    content: '·';
    margin-left: 0.4rem;
    opacity: 0.5;
  }

  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }

  .timeline-item {
    position: relative;
    padding: 0 0 1.75rem 1.35rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -0.28rem;
    top: 0.45rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--copper);
    box-shadow: 0 0 0 4px rgba(212, 160, 106, 0.15);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-width: 0;
  }

  .timeline-role {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--paper);
    letter-spacing: -0.02em;
    min-width: 0;
    flex: 1 1 12rem;
    overflow-wrap: anywhere;
  }

  .timeline-period {
    font-size: 0.82rem;
    color: var(--steel);
    flex: 0 1 auto;
  }

  .timeline-company {
    margin: 0.2rem 0 0.45rem;
    color: var(--copper-bright);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .timeline-highlight {
    margin: 0;
    color: var(--mist);
    font-size: 0.95rem;
  }

  .edu {
    margin-top: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .edu-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--paper);
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .edu-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    color: var(--mist);
    font-size: 0.95rem;
  }

  .edu-list strong {
    color: var(--fog);
    font-weight: 600;
  }

  .contact-inner {
    max-width: 36rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .footer {
    border-top: 1px solid var(--line);
    padding-block: 1.5rem 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.88rem;
    color: var(--mist);
  }

  .footer-inner p {
    margin: 0;
  }

  .footer-inner strong {
    color: var(--paper);
    font-family: var(--font-display);
  }

  .footer-note {
    opacity: 0.8;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  @media (max-width: 480px) {
    .top-nav a {
      font-size: 0.82rem;
    }

    .top-nav a:nth-child(2) {
      display: none;
    }

    .hero {
      min-height: auto;
      padding-block: 2.5rem 2rem;
      align-items: start;
    }

    .hero-media {
      order: 2;
      max-width: min(100%, 22rem);
    }

    .hero-copy {
      order: 1;
    }

    .hero-actions .btn,
    .contact-actions .btn {
      width: 100%;
    }

    .timeline-item {
      padding-left: 1.1rem;
    }
  }

  /* Fallback se o browser não tiver cqi */
  @supports not (font-size: 1cqi) {
    .hero-brand {
      font-size: clamp(1.35rem, 7.2vw, 4.75rem);
    }
  }
</style>
